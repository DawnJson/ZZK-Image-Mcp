{
  "name": "zzk-image-mcp",
  "version": "0.2.0",
  "description": "MCP server for OpenAI-compatible image relay stations (New API / one-api): required quality+size, per-family parameters, and measured per-call cost",
  "type": "module",
  "license": "MIT",
  "author": "DawnJson",
  "homepage": "https://github.com/DawnJson/ZZK-Image-MCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DawnJson/ZZK-Image-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/DawnJson/ZZK-Image-MCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "image-generation",
    "text-to-image",
    "image-to-image",
    "new-api",
    "one-api",
    "openai-compatible",
    "claude-code"
  ],
  "bin": {
    "zzk-image-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "smoke": "node e2e.mjs valid",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}

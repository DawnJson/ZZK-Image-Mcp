ZZKIMAGE_API_KEY=sk-your-key-here
ZZKIMAGE_BASE_URL=https://api.zaizaiking.com
ZZKIMAGE_SAVE_DIR=
# Output sandbox; defaults to ZZKIMAGE_SAVE_DIR. Every save_dir argument must resolve inside it.
ZZKIMAGE_SAVE_DIR_ROOT=
# Optional root for reference images; empty means any readable path is accepted.
ZZKIMAGE_INPUT_ROOT=
# Hosts allowed to serve generated images; defaults to the base URL host and its parent domain.
ZZKIMAGE_TRUSTED_DOWNLOAD_HOSTS=
ZZKIMAGE_DEFAULT_MODEL=gpt-image-2
ZZKIMAGE_TIMEOUT_MS=300000
ZZKIMAGE_CONCURRENCY=3
